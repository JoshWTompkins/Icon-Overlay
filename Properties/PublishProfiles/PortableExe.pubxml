<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)/publish/portable/</PublishDir>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup>
    <ZipName>IconOverlay.zip</ZipName>
    <ZipPath>$(MSBuildProjectDirectory)/publish/$(MsixPackageName)</ZipPath>
  </PropertyGroup>

  <!-- Start each MSIX publish with an empty output directory. -->
  <Target Name="CleanZipPublishDirectory"
          BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)"
               Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- Copy the root-level manifest and shared assets after publishing. -->
  <Target Name="CopyAppFiles"
          AfterTargets="Publish">


    <MakeDir Directories="$(PublishDir)" />


  </Target>
  <!-- <Target Name="ZipPortableExe" AfterTargets="CopyAppFiles">
    <Exec
      Command="bash &quot;$(MSBuildProjectDirectory)/scripts/zip-portable-exe.sh&quot; &quot;$(PublishDir)&quot; &quot;$(MsixPackagePath)&quot;" />
  </Target> -->
</Project>