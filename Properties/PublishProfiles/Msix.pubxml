<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)/publish/msix/</PublishDir>
  </PropertyGroup>

  <PropertyGroup>
    <MsixPackageName>IconOverlay.msix</MsixPackageName>
    <MsixPackagePath>$(MSBuildProjectDirectory)/publish/$(MsixPackageName)</MsixPackagePath>
  </PropertyGroup>

  <!-- Start each MSIX publish with an empty output directory. -->
  <Target Name="CleanMsixPublishDirectory"
          BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)"
               Condition="'$(PublishDir)' != ''" />
  </Target>

  <!-- Copy the root-level manifest and shared assets after publishing. -->
  <Target Name="CopyMsixPackageFiles"
          AfterTargets="Publish">

    <ItemGroup>
      <_MsixAssets 
        Include="$(MSBuildProjectDirectory)/Assets/**/*" 
        Exclude="$(MSBuildProjectDirectory)/Assets/**/*.pxo"
      />
      <_MsixAssetDirs Include="@(_MsixAssets->'$(PublishDir)Assets/%(RecursiveDir)')" />
    </ItemGroup>

    <MakeDir Directories="$(PublishDir)" />
    <MakeDir Directories="@(_MsixAssetDirs)" />

    <Copy
      SourceFiles="$(MSBuildProjectDirectory)/AppxManifest.xml"
      DestinationFiles="$(PublishDir)AppxManifest.xml" />

    <Copy
      SourceFiles="@(_MsixAssets)"
      DestinationFiles="@(_MsixAssets->'$(PublishDir)Assets/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />

  <!-- </Target>
  <Target Name="PackageMsix" AfterTargets="CopyMsixPackageFiles">
    <Exec
      Command="bash &quot;$(MSBuildProjectDirectory)/scripts/package-msix.sh&quot; &quot;$(PublishDir)&quot; &quot;$(MsixPackagePath)&quot;" />
  </Target> -->
</Project>